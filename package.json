{
  "name": "gamma-spectrosim",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "node build.js",
    "watch": "nodemon --watch src/ --watch build.js --ext ts,css,js,html --exec \"node build.js\"",
    "serve": "live-server dist",
    "dev": "concurrently \"npm:watch\" \"npm:serve\""
