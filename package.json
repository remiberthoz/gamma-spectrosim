  "description": "Teaching tool for photopeak identification and isotope recognition in gamma spectroscopy.",
  "dependencies": {
    "picasso.js": "^2.10.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.0",
    "live-server": "^1.2.2",
    "nodemon": "^3.1.14",
    "typescript": "^6.0.3"
  }
}
